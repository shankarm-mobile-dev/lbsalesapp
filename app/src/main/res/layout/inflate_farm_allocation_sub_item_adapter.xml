<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/white"
    android:orientation="vertical">

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardElevation="1dp"
        app:cardUseCompatPadding="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_square_corner_transpernt_menu_list"
            android:orientation="vertical"
            android:padding="2dp">


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:padding="5dp"
                android:weightSum="8">
                <TextView
                    android:id="@+id/vehicle_name_tv"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="2"
                    android:visibility="gone"
                    android:hint="@string/label_vechicle_no"
                    android:padding="5dp"
                    android:textColor="@color/black" />
                <TextView
                    android:id="@+id/branch_name_tv"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="5"
                    android:background="@drawable/bg_border_gray"
                    android:drawableRight="@drawable/ic_drop_down"
                    android:hint=""
                    android:padding="5dp"
                    
                    android:textColor="@color/black" />

                <EditText
                    android:id="@+id/qty_tv"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="2dp"
                    android:layout_weight="1.75"
                    android:background="@drawable/bg_border_gray"
                    android:hint=""
                    android:imeOptions="actionDone"
                    android:inputType="numberDecimal"
                    android:maxLines="1"
                    
                    android:paddingLeft="10dp"
                    android:paddingTop="5dp"
                    android:paddingRight="5dp"
                    android:paddingBottom="5dp"
                    android:textColor="@color/black"
                    android:textSize="14sp" />

                <ImageView
                    android:id="@+id/delete_img"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.25"
                    android:src="@drawable/ic_delete_new" />


            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:padding="5dp"
                android:background="@color/white"
               >



                <TextView

                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="5"
                    
                    android:text="@string/label_ws_name"
                    android:textStyle="bold"
                    android:textColor="@color/black" />

                <TextView

                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="2dp"
                    android:layout_weight="3"
                    android:textStyle="bold"
                    android:text="@string/label_ws_mob"
                    android:imeOptions="actionDone"
                    android:inputType="numberDecimal"
                    android:maxLines="1"
                    android:paddingLeft="2dp"
                    
                    android:paddingRight="5dp"

                    android:textColor="@color/black"
                    android:textSize="14sp" />




            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:padding="5dp"
                >




                <TextView
                    android:id="@+id/emp_name_tv"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="5"
                    android:background="@drawable/bg_border_gray"
                    android:drawableRight="@drawable/ic_drop_down"
                    android:hint=""
                    android:padding="5dp"
                    
                    android:textColor="@color/black" />

                <EditText
                    android:id="@+id/mob_tv"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="2dp"
                    android:layout_weight="3"
                    android:background="@drawable/bg_border_gray"
                    android:hint=""
                    android:imeOptions="actionDone"
                    android:inputType="numberDecimal"
                    android:maxLines="1"
                    android:paddingLeft="10dp"
                    android:paddingTop="5dp"
                    android:paddingRight="5dp"
                    android:paddingBottom="5dp"
                    android:textColor="@color/black"
                    
                    android:textSize="14sp" />



            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:padding="2dp"
                android:background="@color/white"
                >

                <TextView
                    android:id="@+id/txt_prod_detls_1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="2dp"
                    android:layout_weight="3"
                    android:textStyle="bold"
                    android:text="Product "
                    android:imeOptions="actionDone"
                    android:inputType="numberDecimal"
                    
                    android:paddingLeft="5dp"
                    android:visibility="visible"
                    android:paddingRight="5dp"

                    android:textColor="@color/black"
                    android:textSize="14sp" />



                <TextView
                    android:id="@+id/txt_tv2"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="2dp"
                    android:layout_weight="1.75"
                    android:textStyle="bold"
                    android:text="@string/label_avgbdwt"
                    android:imeOptions="actionDone"
                    android:inputType="numberDecimal"
                    
                    android:paddingLeft="2dp"

                    android:paddingRight="5dp"

                    android:textColor="@color/black"
                    android:textSize="14sp" />


            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:padding="5dp"
                >


                <EditText
                    android:id="@+id/qty_tv3"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="2dp"
                    android:layout_weight="3"
                    android:background="@drawable/bg_border_gray"
                    android:text=""
                    android:imeOptions="actionDone"
                    android:drawableRight="@drawable/ic_drop_down"
                    android:visibility="visible"
                    android:paddingLeft="10dp"
                    android:paddingTop="5dp"
                    android:paddingRight="5dp"
                    android:paddingBottom="5dp"
                    android:textColor="@color/black"
                    
                    android:textSize="14sp" />


                <EditText
                    android:id="@+id/qty_tv2"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="2dp"
                    android:layout_weight="1.75"
                    android:background="@drawable/bg_border_gray"
                    android:hint=""
                    android:imeOptions="actionDone"
                    android:inputType="numberDecimal"
                    android:maxLines="1"
                    android:paddingLeft="10dp"
                    android:paddingTop="5dp"
                    android:paddingRight="5dp"
                    android:paddingBottom="5dp"
                    android:textColor="@color/black"
                    
                    android:textSize="14sp" />


            </LinearLayout>
            <LinearLayout
                android:id="@+id/lyt_weighmenttype"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
                android:orientation="vertical">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:padding="5dp"
                android:background="@color/gery_inactive"
                >



                <TextView

                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="3"

                    android:text="@string/label_weighment_type"

                    android:textColor="@color/black" />






            </LinearLayout>
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center|left"
                android:gravity="center|left"
                android:padding="5dp"
                >




                <TextView
                    android:id="@+id/weighment_type_tv"
                    android:layout_width="200dp"
                    android:layout_height="wrap_content"
                    android:gravity="left"
                    android:background="@drawable/bg_border_gray"
                    android:drawableRight="@drawable/ic_drop_down"
                    android:hint=""
                    android:padding="5dp"
                    android:textColor="@color/black" />




            </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:padding="2dp"
                android:orientation="vertical"
                >


                <TextView
                    android:id="@+id/txt_error1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="2dp"
                    android:visibility="gone"
                    android:text="OTP successfully sent text SMS to Trader and Farmer mobile number"
                    android:imeOptions="actionDone"


                    android:paddingLeft="5dp"

                    android:paddingRight="5dp"

                    android:textColor="@color/black"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/txt_error2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:visibility="gone"
                   android:gravity="center"
                    android:text="SMS Validity expired, Click to Resend the SMS"
                    android:textColor="@color/black" />





            </LinearLayout>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <LinearLayout
        android:id="@+id/add_new_branch_lay"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="5dp"
        android:layout_marginBottom="5dp"
        android:background="@drawable/bg_button"
        android:gravity="center"
        android:orientation="horizontal"
        android:padding="10dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            
            android:text="Add New Branch"
            android:textColor="@color/white"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/add_img"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:paddingLeft="10dp"
            android:src="@drawable/ic_add" />
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal">

    <LinearLayout
        android:id="@+id/resent_lay"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="5dp"
        android:layout_marginBottom="5dp"
        android:background="@drawable/bg_button"
        android:gravity="center"
        android:orientation="horizontal"
        android:padding="10dp"
        android:visibility="gone"
       >

        <TextView
            android:id="@+id/resent_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            
            android:text="@string/label_resent"
            android:textColor="@color/white"
            android:textStyle="bold" />

    </LinearLayout>
        <LinearLayout
            android:id="@+id/cancel_lay"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="2dp"
            android:background="@drawable/bg_button"
            android:gravity="center"
            android:orientation="horizontal"
            android:padding="10dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/cancel_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                
                android:text="@string/label_cancel_order"
                android:textColor="@color/white"
                android:textStyle="bold" />

        </LinearLayout>
    <LinearLayout
        android:id="@+id/submit_lay"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="2dp"
        android:background="@drawable/bg_button"
        android:gravity="center"
        android:orientation="horizontal"
        android:padding="10dp"
        android:visibility="visible">

        <TextView
            android:id="@+id/submit_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            
            android:text="@string/label_submit"
            android:textColor="@color/white"
            android:textStyle="bold" />

    </LinearLayout>

    </LinearLayout>
    <View
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:layout_margin="5dp"

        android:background="@color/colorAccent" />
</LinearLayout>