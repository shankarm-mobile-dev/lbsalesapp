<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:ignore="MergeRootFrame" >
    
    <TextView
        android:id="@+id/txtBroilerHdr"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:background="#F78181"
        android:gravity="left|center"
        android:padding="4dp"
        android:text="Broiler Branches"
        android:textColor="@android:color/white"
        android:textSize="14dip"
        android:textStyle="bold"
        android:visibility="visible" />
    
    <TextView
        android:id="@+id/txtRetailHdr"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:background="#F78181"
        android:gravity="left|center"
        android:padding="4dp"
        android:text="Retail Branches"
        android:textColor="@android:color/white"
        android:textSize="14dip"
        android:textStyle="bold"
        android:visibility="visible" />

    <LinearLayout
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="5dip"
        android:id="@+id/lydetail"
        android:visibility="gone"
         >

        <TextView
            android:id="@+id/tvbranchname"
            android:layout_width="150dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="4dp"
            android:gravity="left"
            android:text="0"
            android:textColor="#000000"
            android:textSize="12dip"
            android:textStyle="bold"
            
             />

        <TextView
            android:id="@+id/tvrate"
            android:layout_width="48dp"
            android:layout_height="wrap_content"
            android:layout_marginRight="10dp"
            android:cursorVisible="true"
            android:gravity="right"
            android:inputType="numberDecimal"
            android:text="0"
            android:textColor="#000000"
            android:textCursorDrawable="@null"
            android:textSize="12dip"
            android:textStyle="bold"
            
             />
        
           <View
            android:layout_width="20dp"
            android:layout_height="10dp" />
        
        <EditText
            android:id="@+id/edtrate"
            android:layout_width="10dp"
            android:layout_height="wrap_content"
            android:gravity="right"
            android:inputType="numberDecimal"
            android:text="0"
            android:textColor="#000000"
            android:textSize="12dip"
            android:textStyle="bold"
            android:layout_weight="1"
             />
        
          <TextView
            android:id="@+id/tvfinalprice"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="4dp"
            android:layout_weight="1"
             android:gravity="right"
            android:text="0"
            android:textColor="#000000"
            android:textSize="12dip"
            android:textStyle="bold"
             android:visibility="gone"
             />

<!--  android:focusableInTouchMode="true" -->
        <!-- <View
            android:layout_width="20dp"
            android:layout_height="fill_parent" /> -->
    </LinearLayout> 
</LinearLayout>