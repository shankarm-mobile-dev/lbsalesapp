<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <LinearLayout
        android:id="@+id/recycleview_header"
        android:layout_width="match_parent"
        android:visibility="visible"
        android:layout_height="wrap_content">

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardUseCompatPadding="true">

            <LinearLayout
                android:id="@+id/inflate_menu_card_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"

                android:orientation="horizontal"
                android:padding="5dp"
                android:weightSum="6">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.2"
                    android:orientation="vertical"
                    >
                    <TextView
                        android:id="@+id/branch_tv"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_weight="1.2"
                        
                        android:gravity="left"
                        android:padding="5dp"
                        android:textSize="10sp"
                        android:text="Branch"

                        android:textColor="@color/black"
                        android:textStyle="bold" />

                </LinearLayout>
                <TextView
                    android:id="@+id/customername_tv"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="2"
                    
                    android:padding="5dp"
                    android:layout_gravity="center|top"
                    android:text="Customer Name"
                    android:textSize="10sp"
                    android:textColor="@color/black"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/vehicleno_tv"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.3"
                    
                    android:padding="5dp"
                    android:layout_gravity="center|top"
                    android:text="Vehcile No."
                    android:textSize="10sp"
                    android:textColor="@color/black"
                    android:textStyle="bold" />
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.5"
                    android:orientation="vertical"
                    android:layout_gravity="center|top"
                    >

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        >
                        <TextView
                            android:id="@+id/farmerotp_tv"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:layout_weight="1"
                            
                            android:gravity="right"
                            android:padding="5dp"
                            android:textSize="12sp"
                            android:visibility="visible"
                            android:text="Farmer"

                            android:textColor="@color/red_active"

                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/customerotp_tv"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:layout_weight="1"
                            
                            android:gravity="right"
                            android:padding="5dp"
                            android:text="Customer"
                            android:textColor="@color/red_active"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:visibility="visible" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout

                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.5"
                    
                    android:orientation="vertical"
                    android:padding="5dp"
                    android:textColor="@color/black"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/allocate_tv"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_margin="2dp"
                        android:background="@drawable/bg_button"
                        
                        android:gravity="center"
                        android:text="Allocate"
                        android:textColor="@color/white"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/view_tv"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_margin="2dp"
                        android:background="@drawable/bg_button"
                        
                        android:gravity="center"
                        android:text="View"
                        android:textColor="@color/white"
                        android:textStyle="bold" />
                </LinearLayout>

            </LinearLayout>
        </androidx.cardview.widget.CardView>
    </LinearLayout>
</LinearLayout>