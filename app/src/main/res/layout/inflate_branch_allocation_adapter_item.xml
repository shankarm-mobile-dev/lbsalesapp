<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardElevation=".50dp"
        app:cardUseCompatPadding="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_square_corner_transpernt_menu_list"
            android:orientation="vertical"
            android:padding="@dimen/dimen_10">

            <LinearLayout
                android:id="@+id/inflate_menu_card_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:orientation="horizontal"
                android:weightSum="6">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="2.5"
                    android:orientation="vertical"
                   >
                <TextView
                    android:id="@+id/customer_name_tv"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="2.5"
                    
                    android:padding="5dp"
                    android:text="suguna Foods"
                    android:textStyle="bold"
                    android:textColor="@color/red_active" />
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="0.5dp"
                        android:visibility="visible"
                        android:background="@color/app_gray"></View>
                    <TextView
                        android:id="@+id/lift_time_tv"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_weight="2.5"
                        
                        android:padding="5dp"
                        android:text="time"
                        android:textSize="12dp"
                        android:textStyle="bold"
                        android:visibility="visible"
                        android:drawableLeft="@drawable/ic_transport_order"
                        android:textColor="@color/red_active" />
                </LinearLayout>

                <TextView
                    android:id="@+id/order_qty_tv"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    
                    android:gravity="right"
                    android:padding="5dp"
                    android:text="0"
                    android:textColor="@color/black" />

                <TextView
                    android:id="@+id/required_qty_tv"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    
                    android:gravity="right"
                    android:padding="5dp"
                    android:text="0"
                    android:textColor="@color/black" />

                <LinearLayout

                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.5"
                    
                    android:orientation="vertical"
                    android:padding="5dp"
                    android:textColor="@color/black">

                    <TextView
                        android:id="@+id/allocate_tv"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_margin="2dp"
                        android:background="@drawable/bg_button"
                        
                        android:gravity="center"
                        android:text="@string/allocate"
                        android:textColor="@color/white"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/view_tv"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_margin="2dp"
                        android:background="@drawable/bg_button"
                        
                        android:gravity="center"
                        android:text="View"
                        android:textColor="@color/white"
                        android:textStyle="bold" />
                </LinearLayout>

            </LinearLayout>
            <LinearLayout
                android:id="@+id/lyt_prod_detls"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:visibility="gone"
                android:orientation="vertical"
                >
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:padding="2dp"
                    android:weightSum="2"
                    android:background="@color/gery_inactive"
                    >



                    <TextView

                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.25"
                        
                        android:text="Product "
                        android:textStyle="bold"
                        android:textColor="@color/black" />

                    <TextView

                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight=".75"



                        android:textColor="@color/black" />




                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:padding="2dp"
                    android:weightSum="2">

                    <TextView
                        android:id="@+id/txt_prod_detls"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.25"
                        
                        android:text=""
                        android:padding="5dp"

                        android:textColor="@color/red_active"
                        android:textStyle="bold" />
                    <LinearLayout

                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight=".75"
                        
                        android:orientation="vertical"
                        android:padding="5dp"
                        android:visibility="invisible"
                        android:textColor="@color/black">

                        <TextView

                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_margin="2dp"
                            android:background="@drawable/bg_button"
                            
                            android:gravity="center"
                            android:text="@string/allocate"
                            android:textColor="@color/white"
                            android:textStyle="bold" />

                        <TextView

                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_margin="2dp"
                            android:background="@drawable/bg_button"
                            
                            android:gravity="center"
                            android:text="View"
                            android:textColor="@color/white"
                            android:textStyle="bold" />
                    </LinearLayout>
                    <EditText
                        android:id="@+id/qty_tv"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="2dp"
                        android:layout_weight="2"
                        android:background="@drawable/bg_border_gray"
                        android:hint=""
                        android:imeOptions="actionDone"
                        android:inputType="numberDecimal"
                        android:maxLines="1"
                        android:paddingLeft="10dp"
                        android:paddingTop="5dp"
                        android:paddingRight="5dp"
                        android:paddingBottom="5dp"
                        android:textColor="@color/black"
                        android:visibility="gone"
                        android:textSize="14sp" />



                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:id="@+id/subrecycle_lay"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="visible">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/menu_header_selector"
                    android:padding="5dp"
                    android:weightSum="8">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="2"
                        android:padding="@dimen/dimen5"
                        android:text="@string/label_vechicle_no"
                        android:textColor="@color/white" />
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="3"
                        android:padding="@dimen/dimen5"
                        android:text="@string/label_branch_name"
                        android:textColor="@color/white" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.75"
                        android:text="@string/label_qty"
                        android:textColor="@color/white" />

                    <TextView
                        android:id="@+id/submit_tv"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_weight="1.25"
                        android:background="@drawable/bg_button"
                        android:gravity="center"
                        android:maxLines="1"
                        android:padding="5dp"
                        android:text="Add Branch"
                        android:textColor="@color/white"
                        android:visibility="visible" />
                    <!--<TextView
                        android:id="@+id/cancel_tv"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.25"
                        android:background="@drawable/bg_button"
                        android:maxLines="1"
                        android:padding="5dp"
                        android:layout_gravity="center"
                        android:gravity="center"
                        android:text="@string/label_cancel"
                        android:textColor="@color/white"
                        android:visibility="visible" />-->
                </LinearLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/sub_recyclerview"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
            </LinearLayout>
        </LinearLayout>
    </androidx.cardview.widget.CardView>
</LinearLayout>