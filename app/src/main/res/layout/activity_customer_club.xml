<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:transitionName="toolbar_transition"
    android:fitsSystemWindows="true"
    tools:context=".targetActual.activity.TargetVsActualActivity">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">
        <com.google.android.material.appbar.AppBarLayout
            android:layout_width="match_parent"
            android:transitionName="toolbar_transition"
            android:layout_height="?attr/actionBarSize">

            <androidx.appcompat.widget.Toolbar
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                android:background="?attr/colorPrimary"

                app:theme="@style/ToolBarStyle" />

        </com.google.android.material.appbar.AppBarLayout>

        <LinearLayout
            android:id="@+id/recycleview_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"

            >

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                >

                <LinearLayout
                    android:id="@+id/inflate_menu_card_view"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:background="@drawable/menu_header_selector"
                    android:orientation="vertical"
                    android:padding="12dp"
                    >

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="5dp"
                        android:weightSum="5">
                        <TextView
                            android:id="@+id/days_tv"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="3.5"
                            
                            android:text="Club Type"
                            android:paddingLeft="2dp"
                            android:textColor="@color/white"
                            android:textStyle="bold"
                            android:paddingBottom="5dp"
                            android:paddingRight="2dp"/>

                        <TextView

                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            
                            android:textColor="@color/white"
                            android:textStyle="bold"
                            android:text="Cust1"
                            android:gravity="right"
                            android:visibility="gone"
                            android:paddingRight="2dp"
                            android:paddingBottom="5dp"
                            />

                        <TextView

                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Cust1"
                            android:visibility="gone"
                            android:gravity="right"
                            android:paddingBottom="5dp"
                            android:paddingRight="2dp"
                            
                            android:textColor="@color/white"
                            android:textStyle="bold"
                            />

                        <TextView

                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1.5"
                            android:text="No of \nCustomers"
                            android:gravity="center"
                            
                            android:textColor="@color/white"
                            android:textStyle="bold"
                            android:maxLines="2"
                            android:paddingBottom="5dp"
                            android:paddingRight="2dp"
                            />
                    </LinearLayout>

                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </LinearLayout>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycleview"
            android:background="@color/white"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:scrollbars="none"
            tools:ignore="MissingConstraints" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>