<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:paddingTop="@dimen/dimen5"
    android:paddingBottom="@dimen/dimen5"
    android:background="@color/lightgray"
    android:layout_height="wrap_content">
    <LinearLayout
        android:id="@+id/lyt_prod_name"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"

        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:weightSum="5"


        >

        <TextView
            android:id="@+id/txt_cluster_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="4dp"
            android:layout_weight="2"
            android:gravity="left"
            android:text=""
            android:textColor="@color/black"
            android:textSize="13sp"
            android:paddingTop="8dip"
            android:paddingBottom="8dip"
            
            android:textStyle="bold"
            />
         <LinearLayout
             android:id="@+id/lyt_target_rate"
             android:layout_width="0dp"
             android:layout_height="wrap_content"
             android:gravity="right"
             android:layout_weight="1.25">
        <EditText
            android:id="@+id/edt_target_rate"
            android:layout_width="75dp"
            android:layout_height="wrap_content"
            android:gravity="right"
            android:layout_gravity="right"
            android:inputType="number"
            android:text=""
            android:maxLength="3"
            android:padding="10dp"
            android:background="@drawable/bg_border_gray"
            android:textColor="#000000"
            android:textSize="10sp"

            android:textStyle="bold"
            />
         </LinearLayout>
        <TextView
            android:id="@+id/txt_target_rate"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.25"
            android:gravity="center|right"
            android:text="1.1"
            android:textColor="@color/black"
            android:textSize="10sp"
            android:paddingTop="8dip"
            android:paddingBottom="8dip"
            android:padding="10dp"
            
            />

        <TextView
            android:id="@+id/txt_avg_target"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.75"
            android:gravity="center|right"
            android:text="1.4"
            android:textColor="@color/black"
            android:textSize="10sp"
            android:paddingRight="1dp"
            android:paddingTop="8dip"
            android:paddingBottom="8dip"
            android:padding="10dp"
            
            />




    </LinearLayout>
</LinearLayout>