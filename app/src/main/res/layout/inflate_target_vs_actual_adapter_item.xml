<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:id="@+id/root_lay"
    android:background="@color/white"
    android:padding="@dimen/dimen2"
    >



        <LinearLayout
            android:id="@+id/inflate_menu_card_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="horizontal"
            android:padding="@dimen/dimen_10"
            android:weightSum="5.25">

            <TextView
                android:id="@+id/days_tv"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.5"
                
                android:paddingRight="2dp"
                android:paddingBottom="5dp"
                android:text="suguna Foods"
                android:textColor="@color/black" />

            <TextView
                android:id="@+id/target_qty_tv"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.25"
                
                android:gravity="right"
                android:paddingRight="2dp"
                android:paddingBottom="5dp"
                android:text="0"
                android:textColor="@color/black" />

            <TextView
                android:id="@+id/achieved_qty_tv"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.25"
                
                android:gravity="right"
                android:paddingRight="2dp"
                android:paddingBottom="5dp"
                android:text="0"
                android:textColor="@color/black" />

            <TextView
                android:id="@+id/achieved_percent_tv"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.25"
                
                android:gravity="right"
                android:paddingRight="2dp"
                android:paddingBottom="5dp"
                android:text="0"
                android:textColor="@color/black" />
        </LinearLayout>

</LinearLayout>