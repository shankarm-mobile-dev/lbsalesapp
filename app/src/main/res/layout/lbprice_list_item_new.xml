<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_border_box"
    android:layout_margin="2dp"
    tools:ignore="MergeRootFrame">

    <TextView
        android:id="@+id/txtZoneName"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:background="#F78181"
        android:gravity="left"
        android:padding="4dp"
        android:textColor="@android:color/white"
        android:textSize="14sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <!--     <TextView -->
    <!--         android:id="@+id/txtSatelliteBranch" -->
    <!--         android:layout_width="fill_parent" -->
    <!--         android:layout_height="wrap_content" -->
    <!--         android:background="#FF0040" -->
    <!--         android:gravity="center" -->
    <!--         android:padding="4dp"        -->
    <!--         android:textColor="@android:color/white" -->
    <!--         android:textSize="14dip" -->
    <!--         android:textStyle="bold" -->
    <!--         android:visibility="visible" /> -->

    <TextView
        android:id="@+id/txtBroilerHdr"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:background="@color/bg_button_login"
        android:gravity="center"
        android:padding="4dp"
        android:text="Broiler Branches"
        android:textColor="@android:color/white"
        android:textSize="14sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <TextView
        android:id="@+id/txtRetailHdr"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:background="@color/bg_button_login"
        android:gravity="center"
        android:padding="4dp"
        android:text="Retail Branches"
        android:textColor="@android:color/white"
        android:textSize="14sp"
        android:textStyle="bold"
        android:visibility="gone" />
    <TextView
        android:id="@+id/tvbranchname"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="0dp"
        android:layout_weight="1"
        android:gravity="left"
        android:text="0"
        android:layout_gravity="center"
        android:textColor="#000000"
        android:textSize="12sp"
        android:background="@color/gray_btn_bg_color"
        android:textStyle="bold" />
    <LinearLayout
        android:id="@+id/lydetail"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:padding="5sp"
        android:visibility="visible">
        <LinearLayout
            android:id="@+id/lyt_provisional_price"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <TextView

                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_gravity="center"
                android:padding="5dp"
                android:cursorVisible="true"
                android:gravity="left"
                android:inputType="numberDecimal"
                android:text="Provisional Price"
                android:textColor="#000000"
                android:visibility="visible"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerview_textview"
            android:scrollbars="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            />
        <LinearLayout
            android:id="@+id/lyt_final_price"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <TextView

                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:layout_gravity="center"
                android:padding="5dp"
                android:cursorVisible="true"
                android:gravity="left"
                android:inputType="numberDecimal"
                android:text="Final Price"
                android:textColor="#000000"
                android:visibility="visible"
                android:textSize="12sp"
                android:textStyle="bold" />
            <CheckBox
                android:id="@+id/checkbox_fillfinalprice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="gone"
                android:layout_gravity="center">
            </CheckBox>
        </LinearLayout>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerview_editext"
            android:scrollbars="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            />

        <TextView
            android:id="@+id/tvrate"
            android:layout_width="74dp"
            android:layout_height="wrap_content"
             android:visibility="gone"
            android:layout_gravity="center"
            android:padding="10dp"
            android:cursorVisible="true"
            android:gravity="right"
            android:inputType="numberDecimal"
            android:text="0"
            android:textColor="#000000"

            android:textSize="12sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/tvrate_copp"
            android:layout_width="74dp"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:layout_gravity="center"
            android:padding="10dp"
            android:cursorVisible="true"
            android:gravity="right"
            android:inputType="numberDecimal"
            android:text="0"
            android:textColor="#000000"

            android:textSize="12sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/tvrate_ncopp"
            android:layout_width="74dp"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:layout_gravity="center"
            android:padding="10dp"
            android:cursorVisible="true"
            android:gravity="right"
            android:inputType="numberDecimal"
            android:text="0"
            android:textColor="#000000"

            android:textSize="12sp"
            android:textStyle="bold" />
        <EditText
            android:id="@+id/edtrate"
            android:layout_width="74dp"
            android:layout_height="wrap_content"
            android:gravity="right"
            android:inputType="numberDecimal"
            android:text="0"
            android:layout_gravity="center"
            android:padding="10dp"
            android:background="@drawable/bg_border_gray"
            android:textColor="#000000"
            android:textSize="12sp"
            android:visibility="gone"
            android:textStyle="bold" />
        <EditText
            android:id="@+id/edtrate_cobb"
            android:layout_width="74dp"
            android:layout_height="wrap_content"
            android:gravity="right"
            android:inputType="numberDecimal"
            android:text="0"
            android:layout_gravity="center"
            android:padding="10dp"
            android:background="@drawable/bg_border_gray"
            android:textColor="#000000"
            android:textSize="12sp"
            android:visibility="gone"
            android:textStyle="bold" />
        <EditText
            android:id="@+id/edtrate_ncobb"
            android:layout_width="74dp"
            android:layout_height="wrap_content"
            android:gravity="right"
            android:inputType="numberDecimal"
            android:text="0"
            android:layout_gravity="center"
            android:padding="10dp"
            android:background="@drawable/bg_border_gray"
            android:textColor="#000000"
            android:textSize="12sp"
            android:visibility="gone"
            android:textStyle="bold" />

    </LinearLayout>

</LinearLayout>